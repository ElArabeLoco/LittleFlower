    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@sentry/react": "^8.50.0",
    "@supabase/supabase-js": "^2.97.0",
    "@tanstack/react-query": "^5.67.2",
    "@tanstack/react-router": "^1.114.22",
    "@tanstack/react-table": "^8.21.2",
