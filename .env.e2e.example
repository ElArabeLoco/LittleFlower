# E2E test credentials — copy to .env.e2e.local and fill in real values
# NEVER commit .env.e2e.local (it's gitignored)
#
# Setup:
#   1. Create a dedicated test user in your Supabase project
#   2. Log in as that user manually and complete onboarding (create a household)
#   3. Copy this file to .env.e2e.local and fill in the credentials

E2E_EMAIL=your-test-user@example.com
E2E_PASSWORD=your-test-password
